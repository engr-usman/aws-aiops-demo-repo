# ===== Terraform =====
# Local .terraform directories (provider plugins, modules cache)
**/.terraform/*
.terraform/*

# .tfstate files — even though this project uses an S3 remote backend,
# never commit state locally (a stray local state file could still be
# created accidentally, e.g. during testing without -backend-config).
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data,
# such as password, private keys, and other secrets. This repo's
# terraform.tfvars.example is intentionally NOT excluded (see negation below).
*.tfvars
*.tfvars.json
!terraform.tfvars.example

# Ignore override files as they are usually used to override resources
# locally and so are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Saved plan files (terraform plan -out=...)
*.tfplan
*plan.out

# ===== SSH keys (never commit these) =====
*.pem
*.ppk
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# ===== Editor / OS cruft =====
.DS_Store
.vscode/
.idea/
*.swp

# ===== Logs pulled down from the instance for local inspection =====
bootstrap.log
vllm.log
bench-results/